{
  "name": "ai-forge-support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "catalog:import": "node scripts/import-catalog.ts",
    "catalog:check": "node scripts/check-catalog.ts",
    "chat:check": "node scripts/check-chat.ts",
    "decision:check": "node scripts/check-decision.ts",
    "product:check": "node scripts/check-documents.ts && node scripts/check-handoffs.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.94",
    "@ai-sdk/react": "4.0.184",
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@mastra/ai-sdk": "1.12.1",
    "@mastra/core": "1.85.0",
    "@shadcn/react": "0.3.1",
    "ai": "7.0.179",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.48.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "saxes": "6.0.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
